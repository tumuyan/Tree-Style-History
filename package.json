{
  "name": "tree-style-history",
  "version": "3.3.1",
  "private": true,
  "type": "module",
  "description": "Development tooling for the Tree Style History Chrome MV3 extension. The shippable extension lives in ./chrome and has no build step.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.mjs\"",
    "test:static": "node --test --test-reporter=spec tests/static.test.mjs",
    "test:modules": "node --test --test-reporter=spec tests/modules.test.mjs",
    "test:only": "node --test --test-reporter=spec",
    "test:watch": "node --test --watch --test-reporter=spec \"tests/**/*.test.mjs\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml \"tests/**/*.test.mjs\"",

    "test:e2e": "node --test --test-reporter=spec \"e2e/**/*.spec.mjs\"",
    "test:e2e:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit-e2e.xml \"e2e/**/*.spec.mjs\"",

    "browser:install": "playwright install --with-deps chromium",
    "verify:json": "node scripts/check-json.mjs",
    "verify:syntax": "node scripts/check-syntax.mjs",
    "verify:ci-parity": "node scripts/check-ci-parity.mjs",
    "gen": "npm run gen:sw-utils",
    "gen:sw-utils": "node scripts/gen-sw-utils.mjs",
    "verify:sw-sync": "node scripts/gen-sw-utils.mjs --check",
    "verify": "npm run verify:json && npm run verify:syntax && npm run verify:ci-parity && npm run verify:sw-sync",
    "check": "npm run lint && npm run test && npm run verify",
    "check:ci": "npm run lint && npm run test:ci && npm run verify"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright": "^1.62.1"
  }
}
